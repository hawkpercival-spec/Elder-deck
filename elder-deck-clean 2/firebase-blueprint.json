  "firestore": {
    "/app_registry_users/{userId}": {
      "schema": "AppRegistryUser",
      "description": "Real-time directory of all registered user accounts in the app registry"
    },
    "/app_registry_stats/{statId}": {
      "schema": "AppRegistryStats",
      "description": "Global aggregate tracking real-time user registrations and statistics"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document storing account settings, subscription status, and preferences"
    },
    "/users/{userId}/pairings_meta/{metaId}": {
      "schema": "PairingMeta",
      "description": "Current active 2-day algorithmic selection record for Daily 4 Souls"
    },
    "/users/{userId}/pairings_history/{pairingId}": {
      "schema": "PairingMeta",
      "description": "Historical log of all 2-day algorithmic 4 soul selections"
    },
    "/users/{userId}/band_candidates/{candidateId}": {
      "schema": "BandCandidate",
      "description": "Saved AI match selections and candidates for user's band"
    },
    "/users/{userId}/match_notifications/{notificationId}": {
      "schema": "MatchNotification",
      "description": "Resonance match notifications and alerts"
    },
    "/users/{userId}/payment_logs/{paymentId}": {
      "schema": "PaymentLog",
      "description": "User's payment transactions and receipt log history"
    },
    "/payment_logs/{paymentId}": {
      "schema": "PaymentLog",
      "description": "Global payment transaction ledger for subscription verification"
    },
    "/users/{userId}/history/{entryId}": {
      "schema": "HistoryEntry",
      "description": "Saved tarot card reading history"
    },
    "/users/{userId}/prophecies/{prophecyId}": {
      "schema": "Prophecy",
      "description": "Saved oracle prophecies"
    },
    "/users/{userId}/journals/{journalId}": {
      "schema": "JournalEntry",
      "description": "Crypt journal entry"
    },
    "/public_souls/{soulId}": {
      "schema": "PublicSoul",
      "description": "Directory of real registered soul profiles"
    },
    "/band_invites/{inviteId}": {
      "schema": "BandInvite",
      "description": "Email invitations to join a user's Band"
    },
    "/watch_party_events/{eventId}": {
      "schema": "WatchPartyEvent",
      "description": "Scheduled band movie night events and RSVPs"
    }
  }
